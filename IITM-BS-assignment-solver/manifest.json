{
  "manifest_version": 3,
  "name": "IITM Practice Assignment Solver",
  "description": "One click: fills and submits all unsolved IITM BS practice assignments in a course.",
  "version": "2.1",
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Solve all unsolved practice assignments",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://seek.onlinedegree.iitm.ac.in/*"],
      "js": ["toast.js"]
    }
  ]
}
